# ---------------------------------------------------------------- database ---
# Turso (hosted libSQL). Leave BOTH unset for local development and the app
# falls back to a ./local.db file — no account needed to run it.
#
# Create one:
#   npm i -g turso
#   turso auth signup
#   turso db create ai-roadmap
#   turso db show ai-roadmap --url          -> TURSO_DATABASE_URL
#   turso db tokens create ai-roadmap       -> TURSO_AUTH_TOKEN
#
# Then apply the schema:  npm run db:migrate
#
# In production these are REQUIRED. The app refuses to boot without the URL
# rather than silently writing to a file that a serverless deploy will discard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------- site ---
# Absolute origin, used for canonical URLs, sitemap and OG image tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
