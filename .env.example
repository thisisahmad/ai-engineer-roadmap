# ---------------------------------------------------------------- database ---
# Turso (hosted libSQL). REQUIRED — including locally.
#
# The client uses @libsql/client/web, which speaks HTTP and has no native
# binding. That is what makes it work on Vercel, where a platform-specific
# .node binary cannot be relied on. The trade is that file: URLs are not
# supported, so development points at a Turso database too. Create a second
# free one for dev rather than sharing the production database.
#
# Create one at https://app.turso.tech — sign up, create a database, then copy
# the URL and generate a token from its page. No CLI needed.
#
# The Turso CLI is an alternative but requires WSL on Windows. Note that
# `npm i -g turso` installs the SQL shell (tursodb), NOT the CLI.
#
# Then apply the schema:  npm run db:migrate
#
# Without these the site still builds and every content page works; only
# sign-in, sign-up and account show "Accounts are temporarily unavailable".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------- site ---
# Absolute origin, used for canonical URLs, sitemap and OG image tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------- assistant ---
# Ollama exposes an OpenAI-compatible API. ORIGIN ONLY — the chat route appends
# /v1/chat/completions, so a /v1 suffix here would produce a 404.
OLLAMA_BASE_URL=

# Sent as `Authorization: Bearer <key>`. Only attached when set.
OLLAMA_API_KEY=

# Optional. Defaults to gpt-oss-120b.
OLLAMA_MODEL=gpt-oss-120b
