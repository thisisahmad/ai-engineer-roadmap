# Copy to .env.local and fill in. Never commit the real file — .env* is
# gitignored apart from the examples.
#
# NOTE: this repo also has .env.example, which predates this file and covers
# the same database and site variables. Keep one of the two; having both is
# how they drift apart.

# ------------------------------------------------------------- assistant ---
# Ollama exposes an OpenAI-compatible API. Give the ORIGIN only — the route
# appends /v1/chat/completions itself, so a trailing slash or a /v1 suffix
# here would produce a 404.
#
#   correct    https://ollama.example.com
#   wrong      https://ollama.example.com/v1
OLLAMA_BASE_URL=

# Sent as `Authorization: Bearer <key>`. Omit it for an endpoint that does not
# authenticate — the header is only attached when this is set.
OLLAMA_API_KEY=

# Optional. Defaults to gpt-oss-120b.
OLLAMA_MODEL=gpt-oss-120b

# -------------------------------------------------------------- database ---
# Turso (hosted libSQL). Required, including locally — the client speaks HTTP
# and has no native binding, so file: URLs are not supported.
#
# Create one at https://app.turso.tech, then: npm run db:migrate
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------ site ---
# Absolute origin, used for canonical URLs, sitemap and OG image tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
